# Raydium CP-Swap Configuration
# Copy this file to .env and replace with actual values

# Raydium AMM Program ID (CP-Swap program)
RAYDIUM_AMM_PROGRAM_ID=your_raydium_program_id

# Raydium AMM Pool ID (specific pool you want to trade on)
RAYDIUM_AMM_ID=your_amm_id

# Raydium AMM Authority PDA (pool authority)
RAYDIUM_AMM_AUTHORITY=your_amm_authority

# Pool Coin Token Account (pool vault for coin token)
RAYDIUM_POOL_COIN_TOKEN_ACCOUNT=your_pool_coin_account

# Pool PC Token Account (pool vault for PC token)
RAYDIUM_POOL_PC_TOKEN_ACCOUNT=your_pool_pc_account

# Token Mint Configuration
# Input mint for the swap (leave empty to default to test USDC)
RAYDIUM_INPUT_MINT=your_input_mint_address

# Output mint for the swap (leave empty to default to test tokenMintB)
RAYDIUM_OUTPUT_MINT=your_output_mint_address

# Token Program IDs (only specify for non-standard token programs)
# For USDC and most SPL tokens: TokenkegQfeZyiNwAJbNbGKPFXCWuBvf9Ss623VQ5DA
# For Token2022 tokens: TokenzQdBNbLqP5VEhdkAS6EPFLC1PHnBqCXEpPxuEb
RAYDIUM_INPUT_MINT_PROGRAM=your_input_mint_token_program
RAYDIUM_OUTPUT_MINT_PROGRAM=your_output_mint_token_program

# Instructions:
# 1. Copy this file: cp .env.example .env
# 2. Replace placeholder values with actual Raydium addresses
# 3. Find addresses from:
#    - Raydium's official documentation
#    - Pool information from Raydium's API
#    - On-chain pool discovery tools
#    - Raydium's GitHub repositories
# 4. For token program IDs:
#    - Check the mint account to determine if it's Token2022 or standard SPL
#    - Use appropriate program ID based on token type